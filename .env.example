# Web/CLI load these from .env; Docker Compose injects them as environment variables.
GENESIS_BASE_URL=https://token.moi.matrixorigin.cn/v1
GENESIS_MODEL=
GENESIS_ACCESS_TOKEN=

# Docker Compose settings. Keep the service behind an authenticated HTTPS proxy.
RFQ_BIND_HOST=127.0.0.1
RFQ_PORT=8765
RFQ_IMAGE=rfq-agent:local
# Existing directory containing the reference material; not bundled in the image.
RFQ_DATA_DIR=./data
# Explicit demo opt-in only; keep disabled for deployment.
RFQ_DEMO_APPROVAL=0
